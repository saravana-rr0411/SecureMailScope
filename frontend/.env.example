# SecureMailScope Frontend Environment Example
# Supply your public publishable/anon key from Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Demo Authentication Flag (defaults to true for hackathon/presentation demo mode)
# Set to false to enforce strict Supabase Auth with pre-registered accounts
# VITE_DEMO_AUTH=true
