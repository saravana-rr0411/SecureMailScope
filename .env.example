# SecureMailScope Supabase Configuration Example
# Copy this file to .env and supply your Supabase project credentials.
# NEVER commit real keys or secrets to version control.

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-backend-supabase-service-key

# Frontend Supabase Auth & Role Configuration
# (Use ONLY the public anon/publishable key here, NEVER the service-role secret key)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Dedicated Authentic Auto-PCAP Capture Agent Configuration
# (Kept strictly server-side on Render, never exposed to frontend)
CAPTURE_AGENT_URL=https://capture-agent.yourdomain.com
CAPTURE_AGENT_API_KEY=your-secure-pre-shared-agent-token
CAPTURE_AGENT_TIMEOUT_SECONDS=30.0

# Capture Agent VM Configuration (configured directly on the VM)
# CAPTURE_AGENT_SECRET_KEY=your-secure-pre-shared-agent-token
# AGENT_HOST=0.0.0.0
# AGENT_PORT=9000
# TEST_SMTP_HOST=127.0.0.1
# TEST_SMTP_PORT=2525
# CAPTURE_INTERFACE=lo
